# Everything dockerd/containerd/runc need at runtime, lifted from moby's own
# pkg_setup() CONFIG_CHECK in app-containers/docker (the ebuild's authoritative
# check-config list) and verified line-by-line against v7.2's actual Kconfig
# defaults/types -- most of this tree is off by default even though it sounds
# like baseline infrastructure.
#
# NETFILTER itself defaults to n (bool, no "default" line in net/Kconfig), so
# nothing under it resolves to anything without this fragment, no matter how
# small the rest of the ask looks.  IP_NF_FILTER/IP_NF_NAT/IP_NF_RAW depend on
# IP_NF_IPTABLES_LEGACY, which the ebuild only requires from kernel 6.17
# onward -- true for every board on TAG v7.x here.
#
# Reusable across boards: put KERNEL_CONFIG_FRAGMENTS=("docker") in
# board.conf. Nothing here is board-specific.

# Namespaces -- UTS/IPC/PID/NET default to y already; USER_NS does not
# (rootless mode + the "optional features" half of moby's check).
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# Cgroup controllers. CGROUPS itself is already on; none of its controllers
# default to y.
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=m
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# Misc required bits: bind-mounting /dev/mqueue, container process keyrings.
CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y
# SECCOMP=y already comes from exynos_defconfig; SECCOMP_FILTER is what the
# seccomp profile support in docker/runc actually needs.
CONFIG_SECCOMP_FILTER=y

# Bridge networking: the default docker0 bridge, veth pairs into containers,
# macvlan/ipvlan/vxlan for the other network drivers.
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VXLAN=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_DUMMY=m

# Netfilter core. NETFILTER itself is the actual gate everything below sits
# behind -- off by default, nothing else here matters until it's on.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_NAT=m
CONFIG_BRIDGE_NETFILTER=m

# The legacy iptables chain. Required from kernel 6.17 by the ebuild's own
# version-gated check -- v7.2 needs it even though iptables-nft is the modern
# default; IP_NF_FILTER/IP_NF_NAT/IP_NF_RAW hang off IP_NF_IPTABLES_LEGACY
# specifically, not the plain IP_NF_IPTABLES symbol.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m

# IPVS, for swarm-mode load balancing. Optional in practice, cheap to carry.
CONFIG_IP_VS=m
CONFIG_IP_VS_NFCT=y

# IPsec transform, for the (rarely used) encrypted overlay network driver.
CONFIG_XFRM_USER=m
CONFIG_INET_ESP=m
CONFIG_CRYPTO_GCM=m
CONFIG_CRYPTO_SEQIV=m

# overlay2 storage driver -- the default and the only one wired up on this
# board (target-packages.txt does not pull btrfs-progs or lvm2).
CONFIG_OVERLAY_FS=m

# Root filesystem is ext4 already, but the ACL/security xattr handlers
# default off and containers rely on both.
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
